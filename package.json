{
  "name": "not-defterim",
  "version": "0.0.9",
  "description": "Windows için çevrimdışı çalışan Türkçe not defteri",
  "author": "asilhanalpay",
  "private": true,
  "main": "masaüstü/ana.cjs",
  "scripts": {
    "baslat": "electron .",
    "denetle": "node --check masaüstü/not-dosyaları.cjs && node --check masaüstü/güncelleme.cjs && node --check masaüstü/ana.cjs && node --check masaüstü/köprü.cjs && node --check masaüstü/depolama.cjs && node --check masaüstü/sürüm-bildirimi.cjs && node --check arayüz/tema.js && node --check arayüz/notlar.js && node --check arayüz/sürüm-bildirimi.js && node --test denetimler/*.denetim.cjs",
    "paketle:windows": "node --require ./kurulum-kaynakları/minimatch-uyumu.cjs ./node_modules/electron-builder/cli.js --win nsis --x64 --publish never",
    "denetle:electron": "node --test denetimler/electron.cjs",
    "paketle:windows:aday": "node --require ./kurulum-kaynakları/minimatch-uyumu.cjs ./node_modules/electron-builder/cli.js --config kurulum-kaynakları/güçlendirme-adayı.cjs --win nsis --x64 --publish never",
    "denetle:paket": "node denetimler/paket.cjs",
    "paketle:windows:aday:dizin": "node --require ./kurulum-kaynakları/minimatch-uyumu.cjs ./node_modules/electron-builder/cli.js --config kurulum-kaynakları/güçlendirme-adayı.cjs --win dir --x64 --publish never",
    "paketle:windows:linux": "node kurulum-kaynakları/linux-nsis.cjs",
    "paketle:windows:linux:aday": "node kurulum-kaynakları/linux-nsis.cjs --aday"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "jsdom": "30.1.3",
    "minimatch": "11.0.3"
  },
  "build": {
    "appId": "com.asilhanalpay.notdefterim",
    "productName": "Notes",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "kurulum"
    },
    "files": [
      "masaüstü/**/*",
      "arayüz/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Notes.exe",
      "icon": "kurulum-kaynakları/simge.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "kurulum-kaynakları/kurulum.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ],
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "minimatch": "$minimatch"
  }
}
