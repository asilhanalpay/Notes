{
  "name": "not-defterim",
  "version": "0.0.1",
  "description": "Windows için çevrimdışı çalışan Türkçe not defteri",
  "author": "asilhanalpay",
  "private": true,
  "main": "masaüstü/ana.cjs",
  "scripts": {
    "baslat": "electron .",
    "denetle": "node --check masaüstü/ana.cjs && node --check masaüstü/köprü.cjs && node --check masaüstü/depolama.cjs && node --check masaüstü/sürüm-bildirimi.cjs && node --check arayüz/tema.js && node --check arayüz/notlar.js && node --check arayüz/sürüm-bildirimi.js && node --test denetimler/*.denetim.cjs",
    "paketle:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.asilhanalpay.notdefterim",
    "productName": "Notes",
    "asar": true,
    "directories": {
      "output": "kurulum"
    },
    "files": [
      "masaüstü/**/*",
      "arayüz/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Notes.exe",
      "icon": "kurulum-kaynakları/simge.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "kurulum-kaynakları/kurulum.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ],
      "deleteAppDataOnUninstall": false
    }
  }
}
