{
  "name": "not-defterim",
  "version": "0.0.1",
  "description": "Windows için çevrimdışı çalışan Türkçe not defteri",
  "author": "asilhanalpay",
  "private": true,
  "main": "masaustu/ana.cjs",
  "scripts": {
    "baslat": "electron .",
    "denetle": "node --check masaustu/ana.cjs && node --check masaustu/kopru.cjs && node --check masaustu/depolama.cjs && node --check masaustu/surum-bildirimi.cjs && node --check arayuz/tema.js && node --check arayuz/app.js && node --check arayuz/surum-bildirimi.js && node --test denetimler/*.test.cjs",
    "paketle:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.asilhanalpay.notdefterim",
    "productName": "Notes",
    "asar": true,
    "directories": {
      "output": "kurulum"
    },
    "files": [
      "masaustu/**/*",
      "arayuz/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Notes.exe",
      "icon": "varliklar/simge.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ],
      "deleteAppDataOnUninstall": false
    }
  }
}
